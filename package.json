{
    "name": "raycaster386-map-editor",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "serve": "node server/index.ts",
        "dev:server": "node --watch server/index.ts",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "vue-tsc -b",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "npm run typecheck && npm run lint && npm run format && npm run test && npm run build"
    },
    "dependencies": {
        "@koa/bodyparser": "^6.1.0",
        "@koa/router": "^15.7.0",
        "@laboralphy/raycaster386": "^1.0.0",
        "@mdi/js": "^7.4.47",
        "koa": "^3.2.1",
        "koa-static": "^5.0.0",
        "pinia": "^4.0.3",
        "vue": "^3.5.42",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@types/koa": "^3.0.3",
        "@types/koa__router": "^12.0.5",
        "@types/koa-static": "^4.0.4",
        "@types/node": "^24.13.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "^5.0.1",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.0",
        "happy-dom": "^20.14.5",
        "prettier": "^3.9.8",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.1",
        "vue-tsc": "^3.3.11"
    },
    "description": "Level editor for the raycaster-386 engine",
    "license": "ISC",
    "author": {
        "name": "Raphaël Marandet",
        "email": "raphael.marandet@gmail.com"
    }
}
