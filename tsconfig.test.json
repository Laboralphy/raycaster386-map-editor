{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
        /* `vite/client` is what declares `*.png` and friends as modules: the tests
       import components, and components import assets. */
        "types": ["node", "vitest/globals", "vite/client"],
        "allowImportingTsExtensions": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["tests/**/*.ts", "shared/**/*.ts", "vitest.config.ts"]
}
